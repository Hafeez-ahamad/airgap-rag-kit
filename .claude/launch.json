{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "native",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "airgap",
        "--data-dir",
        "data/dev",
        "--models-dir",
        "../models",
        "serve",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "native-qwen25",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "airgap",
        "--data-dir",
        "data/dev",
        "--models-dir",
        "../models",
        "serve",
        "--port",
        "8000"
      ],
      "env": {
        "AIRGAP_LLM_MODEL": "qwen2.5:7b",
        "AIRGAP_LLM_NUM_CTX": "2048"
      },
      "port": 8000
    }
  ]
}