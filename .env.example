# Copy to .env for local development. Never put real secrets in this file or the repo.
# Install-time secrets are generated by deploy/install.sh (Phase 4) into secret files.

AIRGAP_ENV=development
# Phase 1 only: stub user taken from the X-Dev-User header. Refused when AIRGAP_ENV=production.
AIRGAP_DEV_AUTH=1

POSTGRES_USER=airgap
POSTGRES_DB=airgap
# Dev-only placeholder; production passwords are generated at install time.
POSTGRES_PASSWORD=change-me-dev-only

AIRGAP_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
AIRGAP_LLM_NUM_CTX=4096
AIRGAP_MAX_UPLOAD_BYTES=52428800
AIRGAP_CONFIDENCE_THRESHOLD=0.30

# Local paths (on the host) holding model weights, mounted read-only into the model service.
EMBEDDER_DIR=./models/bge-m3
RERANKER_DIR=./models/bge-reranker-v2-m3
